# ===================================================================
# NagarSetu Environment Configuration Template
# ===================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: NagarSetu includes a built-in resilient local storage engine
# and runs seamlessly out of the box in Demo Mode without external keys.
# ===================================================================

# --- Supabase Cloud Backend (Optional) ---
# When configured, NagarSetu syncs complaints with your remote PostgreSQL instance.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# --- External Notification Webhooks (Optional) ---
# Endpoints for dispatching live SMS / WhatsApp alerts to citizens.
VITE_SMS_GATEWAY_URL=
VITE_WHATSAPP_API_URL=

# --- AI & Multimodal Intelligence (Optional) ---
# Used for advanced Gemini API multimodal categorizations and translation.
VITE_GEMINI_API_KEY=
